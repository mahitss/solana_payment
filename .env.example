# CiteRail environment configuration.
#
# Copy this file to `.env` and fill in the values for your machine:
#   cp .env.example .env
#
# NEVER commit a real `.env` file or paste production credentials into this
# example. Every secret below is injected at deploy time (for example through
# the Render dashboard) and is read from the process environment only.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required.
# Use a placeholder password here - never a real one.
# Neon (and most hosted Postgres providers) require TLS, so keep
# `sslmode=require` in the query string. Certificate verification stays on.
DATABASE_URL=postgresql://user:placeholder_password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Secret used to HMAC-sign publisher session tokens.
# Generate with: openssl rand -hex 32
# Required in production and must be at least 32 characters long.
# In development an ephemeral per-process secret is generated if this is unset,
# which means sessions are invalidated on every restart.
AUTH_SECRET=

# Lifetime of an issued publisher session token, in seconds (default 12 hours).
SESSION_TTL_SECONDS=43200

# Lifetime of a single-use wallet authentication challenge, in seconds.
AUTH_CHALLENGE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Solana (Devnet)
# ---------------------------------------------------------------------------

# JSON-RPC endpoint used by the server to fetch and verify transactions.
# The public Devnet endpoint works for development; use a dedicated provider
# endpoint for anything beyond local testing.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Cluster label used when building Solana Explorer links.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# SPL mint address of the settlement asset (USDC on Solana Devnet).
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Memo program used to bind a payment transaction to its quote.
NEXT_PUBLIC_MEMO_PROGRAM_ID=MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------

# Base URL of an Ollama instance used for grounded answer generation.
# Point this at a reachable Ollama server; the loopback default only works
# when Ollama runs on the same machine as the app.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama model tag to use, for example `gemma3:4b`.
OLLAMA_MODEL=gemma3:4b

# Google Gemini API key. Optional - when set it is preferred over Ollama.
# When no provider (Ollama or Gemini) is reachable the API fails closed and
# refuses to release a paid answer.
GEMINI_API_KEY=

# Gemini model id used for grounded answer generation.
GEMINI_MODEL=gemini-2.0-flash

# Timeout for outbound AI provider requests, in milliseconds.
AI_REQUEST_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Request limits and settlement policy
# ---------------------------------------------------------------------------

# How long a payment quote stays valid, in seconds (5 minutes).
QUOTE_EXPIRY_SECONDS=300

# Maximum accepted upload size in bytes (10 MiB).
MAX_UPLOAD_BYTES=10485760

# Maximum accepted query length in characters.
MAX_QUERY_LENGTH=2000
